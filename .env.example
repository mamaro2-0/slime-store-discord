# Copy these into your hosting provider's Environment Variables / Secrets.
# Never commit your real .env file or share your Discord webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_NEW_WEBHOOK
PORT=3000
# Optional: folder for orders.log (backup of every order). On Render, use a persistent disk path.
# ORDERS_DIR=/var/data
